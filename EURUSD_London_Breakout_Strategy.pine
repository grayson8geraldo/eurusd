// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © EURUSD London Breakout Strategy v2.0
// Optimized on EUR/USD H1 data (2024-2026)
// Backtest: 81% WR, PF=1.90, $200→$832 at 0.05 lot

//@version=6
strategy("EUR/USD London Breakout",
     overlay=true,
     initial_capital=200,
     default_qty_type=strategy.fixed,
     default_qty_value=5000,          // 0.05 lot
     currency=currency.USD,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.5,            // ~0.5 pip spread
     slippage=1,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     max_bars_back=500)

// ═══════════════════════════════════════════════════════════════
// ВХОДНЫЕ ПАРАМЕТРЫ (INPUT SETTINGS)
// ═══════════════════════════════════════════════════════════════

grp1 = "📊 Сессии / Sessions"
asianStart    = input.int(0,  "Asian Session Start (UTC hour)", minval=0, maxval=23, group=grp1)
asianEnd      = input.int(6,  "Asian Session End (UTC hour)",   minval=0, maxval=23, group=grp1)
entryStart    = input.int(8,  "Entry Window Start (UTC hour)",  minval=0, maxval=23, group=grp1)
entryEnd      = input.int(11, "Entry Window End (UTC hour)",    minval=0, maxval=23, group=grp1)
closeHour     = input.int(20, "Force Close Hour (UTC)",         minval=0, maxval=23, group=grp1)

grp2 = "🎯 Торговые параметры / Trade Settings"
asianMinPips  = input.float(15.0, "Min Asian Range (pips)",  minval=5,  maxval=100, step=1, group=grp2)
asianMaxPips  = input.float(60.0, "Max Asian Range (pips)",  minval=10, maxval=150, step=5, group=grp2)
tpMultiplier  = input.float(0.6,  "TP Multiplier (x Asian Range)", minval=0.3, maxval=3.0, step=0.1, group=grp2)
slPadPips     = input.float(10.0, "SL Padding (pips)",       minval=0, maxval=30, step=1, group=grp2)
maxHoldBars   = input.int(6,      "Max Hold (bars)",         minval=1, maxval=20, group=grp2)

grp3 = "🔍 Фильтры / Filters"
useEmaFilter  = input.bool(true,  "Use EMA Trend Filter",   group=grp3)
emaLength     = input.int(21,     "EMA Length",              minval=5, maxval=200, group=grp3)
useRsiFilter  = input.bool(false, "Use RSI Filter",          group=grp3)
rsiLength     = input.int(14,     "RSI Length",              minval=5, maxval=30, group=grp3)
rsiThreshold  = input.int(50,     "RSI Threshold",           minval=30, maxval=70, group=grp3)

grp4 = "📈 Управление капиталом / Money Management"
useFixedLot     = input.bool(true,  "Fixed Lot Size",        group=grp4)
riskPercent     = input.float(3.0,  "Risk % per Trade (if dynamic)", minval=0.5, maxval=10, step=0.5, group=grp4)
maxTradesPerDay = input.int(1,      "Max Trades per Day",    minval=1, maxval=3, group=grp4)

grp5 = "🎨 Визуализация / Display"
showAsianBox   = input.bool(true, "Show Asian Range Box",    group=grp5)
showSignals    = input.bool(true, "Show Entry Signals",      group=grp5)
showSLTP       = input.bool(true, "Show SL/TP Lines",        group=grp5)
showDashboard  = input.bool(true, "Show Info Dashboard",     group=grp5)

// ═══════════════════════════════════════════════════════════════
// РАСЧЁТ ИНДИКАТОРОВ (INDICATORS)
// ═══════════════════════════════════════════════════════════════

emaValue = ta.ema(close, emaLength)
rsiValue = ta.rsi(close, rsiLength)

// ═══════════════════════════════════════════════════════════════
// ОПРЕДЕЛЕНИЕ АЗИАТСКОЙ СЕССИИ (ASIAN SESSION RANGE)
// ═══════════════════════════════════════════════════════════════

utcHour = hour(time, "UTC")

isAsianSession = utcHour >= asianStart and utcHour <= asianEnd
isEntryWindow  = utcHour >= entryStart and utcHour <= entryEnd
isForceClose   = utcHour >= closeHour

// Track Asian session high/low
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var bool  asianDefined = false
var int   tradesToday = 0
var int   lastTradeDay = 0

// Detect new day
newDay = ta.change(dayofweek(time, "UTC")) != 0

if newDay
    asianHigh := na
    asianLow  := na
    asianRange := na
    asianDefined := false
    tradesToday := 0

// Build Asian range
if isAsianSession
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) * 10000  // in pips

// Mark Asian range as defined when session ends
if not isAsianSession and not na(asianHigh) and not na(asianLow)
    asianDefined := true

// ═══════════════════════════════════════════════════════════════
// ТОРГОВАЯ ЛОГИКА (TRADE LOGIC)
// ═══════════════════════════════════════════════════════════════

// Calculate levels
float tpPips = asianDefined ? asianRange * tpMultiplier : na
float slPips = asianDefined ? asianRange + slPadPips : na

// Range filter
rangeOk = asianDefined and asianRange >= asianMinPips and asianRange <= asianMaxPips

// EMA filter
emaLongOk  = useEmaFilter ? close > emaValue : true
emaShortOk = useEmaFilter ? close < emaValue : true

// RSI filter
rsiLongOk  = useRsiFilter ? rsiValue > rsiThreshold : true
rsiShortOk = useRsiFilter ? rsiValue < (100 - rsiThreshold) : true

// Breakout conditions
breakoutUp   = close > asianHigh and close > open  // Bullish close above Asian high
breakoutDown = close < asianLow  and close < open   // Bearish close below Asian low

// Entry signals
longSignal  = isEntryWindow and rangeOk and breakoutUp   and emaLongOk  and rsiLongOk  and tradesToday < maxTradesPerDay and strategy.position_size == 0
shortSignal = isEntryWindow and rangeOk and breakoutDown and emaShortOk and rsiShortOk and tradesToday < maxTradesPerDay and strategy.position_size == 0

// Position sizing
float posSize = useFixedLot ? 5000 : math.floor((strategy.equity * riskPercent / 100) / (slPips * 0.0001) / 100000 * 100000)
posSize := math.max(posSize, 1000)  // minimum 0.01 lot

// ═══════════════════════════════════════════════════════════════
// ИСПОЛНЕНИЕ ОРДЕРОВ (ORDER EXECUTION)
// ═══════════════════════════════════════════════════════════════

// Track entry bar for max hold
var int entryBar = 0

if longSignal
    float sl = close - slPips * 0.0001
    float tp = close + tpPips * 0.0001
    strategy.entry("Long", strategy.long, qty=posSize)
    strategy.exit("TP/SL Long", "Long", stop=sl, limit=tp)
    entryBar := bar_index
    tradesToday += 1

if shortSignal
    float sl = close + slPips * 0.0001
    float tp = close - tpPips * 0.0001
    strategy.entry("Short", strategy.short, qty=posSize)
    strategy.exit("TP/SL Short", "Short", stop=sl, limit=tp)
    entryBar := bar_index
    tradesToday += 1

// Force close at end of day or max hold
if strategy.position_size != 0
    barsHeld = bar_index - entryBar
    if isForceClose or barsHeld >= maxHoldBars
        strategy.close_all("Time/MaxBars Exit")

// ═══════════════════════════════════════════════════════════════
// ВИЗУАЛИЗАЦИЯ (VISUALIZATION)
// ═══════════════════════════════════════════════════════════════

// EMA line
plot(useEmaFilter ? emaValue : na, "EMA", color=color.new(color.orange, 30), linewidth=2)

// Asian range box
var box asianBox = na
if showAsianBox and isAsianSession and not na(asianHigh) and not na(asianLow)
    if not na(asianBox)
        box.delete(asianBox)
    boxColor = color.new(color.blue, 85)
    asianBox := box.new(bar_index - 1, asianHigh, bar_index + 20, asianLow,
                         border_color=color.new(color.blue, 50),
                         bgcolor=boxColor,
                         border_width=1,
                         border_style=line.style_dashed)

// Asian high/low lines extended into London
var line asianHighLine = na
var line asianLowLine  = na

if showAsianBox and asianDefined and isEntryWindow
    if not na(asianHighLine)
        line.delete(asianHighLine)
    if not na(asianLowLine)
        line.delete(asianLowLine)
    asianHighLine := line.new(bar_index - 5, asianHigh, bar_index + 5, asianHigh,
                              color=color.new(color.teal, 30), width=2, style=line.style_dotted)
    asianLowLine  := line.new(bar_index - 5, asianLow, bar_index + 5, asianLow,
                              color=color.new(color.red, 30), width=2, style=line.style_dotted)

// Entry signals
plotshape(showSignals and longSignal,  title="BUY",  text="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)
plotshape(showSignals and shortSignal, title="SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),   textcolor=color.white, size=size.normal)

// SL/TP levels on entry
var line slLine = na
var line tpLine = na

if showSLTP and (longSignal or shortSignal)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)

    if longSignal
        slLine := line.new(bar_index, close - slPips * 0.0001, bar_index + maxHoldBars, close - slPips * 0.0001,
                           color=color.red, width=2, style=line.style_solid)
        tpLine := line.new(bar_index, close + tpPips * 0.0001, bar_index + maxHoldBars, close + tpPips * 0.0001,
                           color=color.green, width=2, style=line.style_solid)
    if shortSignal
        slLine := line.new(bar_index, close + slPips * 0.0001, bar_index + maxHoldBars, close + slPips * 0.0001,
                           color=color.red, width=2, style=line.style_solid)
        tpLine := line.new(bar_index, close - tpPips * 0.0001, bar_index + maxHoldBars, close - tpPips * 0.0001,
                           color=color.green, width=2, style=line.style_solid)

// ═══════════════════════════════════════════════════════════════
// ИНФОРМАЦИОННАЯ ПАНЕЛЬ (DASHBOARD)
// ═══════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 8,
                               bgcolor=color.new(color.black, 80),
                               border_width=1,
                               border_color=color.new(color.gray, 50))

    table.cell(dash, 0, 0, "EUR/USD London Breakout", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, "", text_color=color.white)

    table.cell(dash, 0, 1, "Asian Range:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, asianDefined ? str.tostring(asianRange, "#.0") + " pips" : "Building...",
               text_color=asianDefined ? (rangeOk ? color.green : color.red) : color.yellow, text_size=size.small)

    table.cell(dash, 0, 2, "Asian High:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, not na(asianHigh) ? str.tostring(asianHigh, "#.#####") : "-", text_color=color.teal, text_size=size.small)

    table.cell(dash, 0, 3, "Asian Low:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, not na(asianLow) ? str.tostring(asianLow, "#.#####") : "-", text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 4, "TP Target:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, not na(tpPips) ? str.tostring(tpPips, "#.0") + " pips" : "-", text_color=color.green, text_size=size.small)

    table.cell(dash, 0, 5, "SL Distance:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, not na(slPips) ? str.tostring(slPips, "#.0") + " pips" : "-", text_color=color.red, text_size=size.small)

    table.cell(dash, 0, 6, "EMA Filter:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    emaTxt = useEmaFilter ? (close > emaValue ? "BULLISH" : "BEARISH") : "OFF"
    emaClr = useEmaFilter ? (close > emaValue ? color.green : color.red) : color.gray
    table.cell(dash, 1, 6, emaTxt, text_color=emaClr, text_size=size.small)

    table.cell(dash, 0, 7, "Trades Today:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay),
               text_color=tradesToday >= maxTradesPerDay ? color.red : color.green, text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// АЛЕРТЫ (ALERTS)
// ═══════════════════════════════════════════════════════════════

alertcondition(longSignal,  title="Long Signal",  message="EUR/USD London Breakout: BUY at {{close}}, SL={{plot_0}}, TP={{plot_1}}")
alertcondition(shortSignal, title="Short Signal", message="EUR/USD London Breakout: SELL at {{close}}, SL={{plot_0}}, TP={{plot_1}}")
alertcondition(asianDefined and rangeOk, title="Asian Range Ready", message="EUR/USD: Asian range defined - {{plot_2}} pips. Ready for London breakout.")

// Hidden plots for alerts
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? close - slPips * 0.0001 : close + slPips * 0.0001) : na, "SL Level", display=display.none)
plot(strategy.position_size != 0 ? (strategy.position_size > 0 ? close + tpPips * 0.0001 : close - tpPips * 0.0001) : na, "TP Level", display=display.none)
plot(asianRange, "Asian Range", display=display.none)

// Background coloring for sessions
bgcolor(isAsianSession ? color.new(color.blue, 95) : na, title="Asian Session")
bgcolor(isEntryWindow ? color.new(color.green, 95) : na, title="Entry Window")
