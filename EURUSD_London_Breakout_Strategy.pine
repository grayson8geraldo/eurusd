// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © EURUSD London Breakout + Overlap Momentum Strategy v3.0
// Optimized on EUR/USD H1 data (2024-2026)
// Combined backtest: 569 trades, 60.5% WR, PF=1.60, $200→$1172 at 0.05 lot

//@version=6
strategy("EUR/USD London Breakout + Momentum",
     overlay=true,
     initial_capital=200,
     default_qty_type=strategy.fixed,
     default_qty_value=5000,          // 0.05 lot
     currency=currency.USD,
     commission_type=strategy.commission.cash_per_order,
     commission_value=0.5,            // ~0.5 pip spread
     slippage=1,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     max_bars_back=500)

// ═══════════════════════════════════════════════════════════════
// ВХОДНЫЕ ПАРАМЕТРЫ (INPUT SETTINGS)
// ═══════════════════════════════════════════════════════════════

grp1 = "SESSION TIMING"
asianStart     = input.int(0,  "Asian Session Start (UTC hour)", minval=0, maxval=23, group=grp1)
asianEnd       = input.int(6,  "Asian Session End (UTC hour)",   minval=0, maxval=23, group=grp1)
entryStart     = input.int(8,  "London Entry Start (UTC hour)",  minval=0, maxval=23, group=grp1)
entryEnd       = input.int(11, "London Entry End (UTC hour)",    minval=0, maxval=23, group=grp1)
overlapStart   = input.int(13, "Overlap Entry Start (UTC hour)", minval=0, maxval=23, group=grp1)
overlapEnd     = input.int(15, "Overlap Entry End (UTC hour)",   minval=0, maxval=23, group=grp1)
closeHour      = input.int(20, "Force Close Hour (UTC)",         minval=0, maxval=23, group=grp1)

grp2 = "LONDON BREAKOUT SETTINGS"
asianMinPips   = input.float(15.0, "Min Asian Range (pips)",  minval=5,  maxval=100, step=1, group=grp2)
asianMaxPips   = input.float(60.0, "Max Asian Range (pips)",  minval=10, maxval=150, step=5, group=grp2)
tpMultiplier   = input.float(0.6,  "TP Multiplier (x Asian Range)", minval=0.3, maxval=3.0, step=0.1, group=grp2)
slPadPips      = input.float(10.0, "SL Padding (pips)",       minval=0, maxval=30, step=1, group=grp2)
maxHoldBarsLB  = input.int(6,      "Max Hold Bars (London)",  minval=1, maxval=20, group=grp2)

grp2b = "OVERLAP MOMENTUM SETTINGS"
useOverlap     = input.bool(true,   "Enable Overlap Momentum",     group=grp2b)
omBodyMult     = input.float(1.2,   "Body Size Multiplier (x avg)", minval=0.8, maxval=3.0, step=0.1, group=grp2b)
omVolMult      = input.float(1.5,   "Volume Multiplier (x avg)",    minval=0.8, maxval=3.0, step=0.1, group=grp2b)
omRsiLo        = input.int(35,      "RSI Lower Bound",              minval=20, maxval=50, group=grp2b)
omRsiHi        = input.int(70,      "RSI Upper Bound",              minval=50, maxval=80, group=grp2b)
omSlPips       = input.float(10.0,  "SL (pips)",                    minval=5, maxval=30, step=1, group=grp2b)
omTpPips       = input.float(15.0,  "TP (pips)",                    minval=5, maxval=50, step=1, group=grp2b)
maxHoldBarsOM  = input.int(8,       "Max Hold Bars (Overlap)",      minval=1, maxval=20, group=grp2b)

grp3 = "FILTERS"
useEmaFilter   = input.bool(true,  "Use EMA Trend Filter (London)", group=grp3)
emaLength      = input.int(21,     "EMA Length",              minval=5, maxval=200, group=grp3)
useRsiFilter   = input.bool(false, "Use RSI Filter (London)", group=grp3)
rsiLength      = input.int(14,     "RSI Length",              minval=5, maxval=30, group=grp3)
rsiThreshold   = input.int(50,     "RSI Threshold (London)",  minval=30, maxval=70, group=grp3)

grp4 = "MONEY MANAGEMENT"
useFixedLot      = input.bool(true,  "Fixed Lot Size",        group=grp4)
riskPercent      = input.float(3.0,  "Risk % per Trade (if dynamic)", minval=0.5, maxval=10, step=0.5, group=grp4)
maxTradesPerDay  = input.int(2,      "Max Trades per Day",    minval=1, maxval=5, group=grp4)

grp5 = "DISPLAY"
showAsianBox   = input.bool(true, "Show Asian Range Box",    group=grp5)
showSignals    = input.bool(true, "Show Entry Signals",      group=grp5)
showSLTP       = input.bool(true, "Show SL/TP Lines",        group=grp5)
showDashboard  = input.bool(true, "Show Info Dashboard",     group=grp5)

// ═══════════════════════════════════════════════════════════════
// РАСЧЁТ ИНДИКАТОРОВ (INDICATORS)
// ═══════════════════════════════════════════════════════════════

emaValue   = ta.ema(close, emaLength)
rsiValue   = ta.rsi(close, rsiLength)
avgBody    = ta.sma(math.abs(close - open), 20)
avgVolume  = ta.sma(volume, 20)

// ═══════════════════════════════════════════════════════════════
// ОПРЕДЕЛЕНИЕ АЗИАТСКОЙ СЕССИИ (ASIAN SESSION RANGE)
// ═══════════════════════════════════════════════════════════════

utcHour = hour(time, "UTC")

isAsianSession  = utcHour >= asianStart and utcHour <= asianEnd
isLondonEntry   = utcHour >= entryStart and utcHour <= entryEnd
isOverlapEntry  = utcHour >= overlapStart and utcHour <= overlapEnd
isForceClose    = utcHour >= closeHour

// Track Asian session high/low
var float asianHigh = na
var float asianLow  = na
var float asianRange = na
var bool  asianDefined = false
var int   tradesToday = 0
var int   londonTradesToday = 0
var int   overlapTradesToday = 0

// Detect new day
newDay = ta.change(dayofweek(time, "UTC")) != 0

if newDay
    asianHigh := na
    asianLow  := na
    asianRange := na
    asianDefined := false
    tradesToday := 0
    londonTradesToday := 0
    overlapTradesToday := 0

// Build Asian range
if isAsianSession
    if na(asianHigh)
        asianHigh := high
        asianLow  := low
    else
        asianHigh := math.max(asianHigh, high)
        asianLow  := math.min(asianLow, low)
    asianRange := (asianHigh - asianLow) * 10000  // in pips

// Mark Asian range as defined when session ends
if not isAsianSession and not na(asianHigh) and not na(asianLow)
    asianDefined := true

// ═══════════════════════════════════════════════════════════════
// MODULE 1: LONDON BREAKOUT (08:00-11:00 UTC)
// WR=81%, PF=1.90, 217 trades over 2.25 years
// ═══════════════════════════════════════════════════════════════

// Calculate London breakout levels
float lbTpPips = asianDefined ? asianRange * tpMultiplier : na
float lbSlPips = asianDefined ? asianRange + slPadPips : na

// Range filter
rangeOk = asianDefined and asianRange >= asianMinPips and asianRange <= asianMaxPips

// EMA filter
emaLongOk  = useEmaFilter ? close > emaValue : true
emaShortOk = useEmaFilter ? close < emaValue : true

// RSI filter
rsiLongOk  = useRsiFilter ? rsiValue > rsiThreshold : true
rsiShortOk = useRsiFilter ? rsiValue < (100 - rsiThreshold) : true

// Breakout conditions
breakoutUp   = close > asianHigh and close > open  // Bullish close above Asian high
breakoutDown = close < asianLow  and close < open   // Bearish close below Asian low

// London entry signals
lbLongSignal  = isLondonEntry and rangeOk and breakoutUp   and emaLongOk  and rsiLongOk  and londonTradesToday < 1 and strategy.position_size == 0 and tradesToday < maxTradesPerDay
lbShortSignal = isLondonEntry and rangeOk and breakoutDown and emaShortOk and rsiShortOk and londonTradesToday < 1 and strategy.position_size == 0 and tradesToday < maxTradesPerDay

// ═══════════════════════════════════════════════════════════════
// MODULE 2: OVERLAP MOMENTUM (13:00-15:00 UTC)
// WR=46.5%, PF=1.30, R:R=1:1.5, 542 trades over 2.25 years
// ═══════════════════════════════════════════════════════════════

// Momentum candle detection
currentBody = math.abs(close - open)
isMomentumCandle = currentBody > avgBody * omBodyMult
isHighVolume     = volume > avgVolume * omVolMult
isRsiInRange     = rsiValue > omRsiLo and rsiValue < omRsiHi
isBullCandle     = close > open
isBearCandle     = close < open

// Overlap entry signals
omLongSignal  = useOverlap and isOverlapEntry and isMomentumCandle and isHighVolume and isRsiInRange and isBullCandle and overlapTradesToday < 1 and strategy.position_size == 0 and tradesToday < maxTradesPerDay
omShortSignal = useOverlap and isOverlapEntry and isMomentumCandle and isHighVolume and isRsiInRange and isBearCandle and overlapTradesToday < 1 and strategy.position_size == 0 and tradesToday < maxTradesPerDay

// ═══════════════════════════════════════════════════════════════
// COMBINED SIGNALS
// ═══════════════════════════════════════════════════════════════

longSignal  = lbLongSignal  or omLongSignal
shortSignal = lbShortSignal or omShortSignal

// Determine which module triggered for SL/TP
isLondonTrade  = lbLongSignal or lbShortSignal
isOverlapTrade = omLongSignal or omShortSignal

// Active SL/TP based on trade type
float activeTpPips = isLondonTrade ? lbTpPips : omTpPips
float activeSlPips = isLondonTrade ? lbSlPips : omSlPips
int   activeMaxBars = isLondonTrade ? maxHoldBarsLB : maxHoldBarsOM

// Position sizing
float posSize = useFixedLot ? 5000 : math.floor((strategy.equity * riskPercent / 100) / (activeSlPips * 0.0001) / 100000 * 100000)
posSize := math.max(posSize, 1000)  // minimum 0.01 lot

// ═══════════════════════════════════════════════════════════════
// ИСПОЛНЕНИЕ ОРДЕРОВ (ORDER EXECUTION)
// ═══════════════════════════════════════════════════════════════

// Track entry bar and type for max hold
var int entryBar = 0
var int currentMaxHold = 6
var string tradeModule = ""

if longSignal
    float sl = close - activeSlPips * 0.0001
    float tp = close + activeTpPips * 0.0001
    string entryId = isLondonTrade ? "LB Long" : "OM Long"
    strategy.entry(entryId, strategy.long, qty=posSize)
    strategy.exit("TP/SL " + entryId, entryId, stop=sl, limit=tp)
    entryBar := bar_index
    currentMaxHold := activeMaxBars
    tradesToday += 1
    tradeModule := isLondonTrade ? "London" : "Overlap"
    if isLondonTrade
        londonTradesToday += 1
    else
        overlapTradesToday += 1

if shortSignal
    float sl = close + activeSlPips * 0.0001
    float tp = close - activeTpPips * 0.0001
    string entryId = isLondonTrade ? "LB Short" : "OM Short"
    strategy.entry(entryId, strategy.short, qty=posSize)
    strategy.exit("TP/SL " + entryId, entryId, stop=sl, limit=tp)
    entryBar := bar_index
    currentMaxHold := activeMaxBars
    tradesToday += 1
    tradeModule := isLondonTrade ? "London" : "Overlap"
    if isLondonTrade
        londonTradesToday += 1
    else
        overlapTradesToday += 1

// Force close at end of day or max hold
if strategy.position_size != 0
    barsHeld = bar_index - entryBar
    if isForceClose or barsHeld >= currentMaxHold
        strategy.close_all("Time/MaxBars Exit")

// ═══════════════════════════════════════════════════════════════
// ВИЗУАЛИЗАЦИЯ (VISUALIZATION)
// ═══════════════════════════════════════════════════════════════

// EMA line
plot(useEmaFilter ? emaValue : na, "EMA", color=color.new(color.orange, 30), linewidth=2)

// Asian range box
var box asianBox = na
if showAsianBox and isAsianSession and not na(asianHigh) and not na(asianLow)
    if not na(asianBox)
        box.delete(asianBox)
    asianBox := box.new(bar_index - 1, asianHigh, bar_index + 20, asianLow,
                         border_color=color.new(color.blue, 50),
                         bgcolor=color.new(color.blue, 85),
                         border_width=1,
                         border_style=line.style_dashed)

// Asian high/low lines extended into London
var line asianHighLine = na
var line asianLowLine  = na

if showAsianBox and asianDefined and (isLondonEntry or isOverlapEntry)
    if not na(asianHighLine)
        line.delete(asianHighLine)
    if not na(asianLowLine)
        line.delete(asianLowLine)
    asianHighLine := line.new(bar_index - 5, asianHigh, bar_index + 5, asianHigh,
                              color=color.new(color.teal, 30), width=2, style=line.style_dotted)
    asianLowLine  := line.new(bar_index - 5, asianLow, bar_index + 5, asianLow,
                              color=color.new(color.red, 30), width=2, style=line.style_dotted)

// Entry signals — London Breakout (green/red) vs Overlap Momentum (blue/purple)
plotshape(showSignals and lbLongSignal,  title="LB BUY",   text="LB\nBUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.green, 0),  textcolor=color.white, size=size.normal)
plotshape(showSignals and lbShortSignal, title="LB SELL",  text="LB\nSELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0),    textcolor=color.white, size=size.normal)
plotshape(showSignals and omLongSignal,  title="OM BUY",   text="OM\nBUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.blue, 0),   textcolor=color.white, size=size.normal)
plotshape(showSignals and omShortSignal, title="OM SELL",  text="OM\nSELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.purple, 0), textcolor=color.white, size=size.normal)

// SL/TP levels on entry
var line slLine = na
var line tpLine = na

if showSLTP and (longSignal or shortSignal)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)

    int holdBars = isLondonTrade ? maxHoldBarsLB : maxHoldBarsOM

    if longSignal
        slLine := line.new(bar_index, close - activeSlPips * 0.0001, bar_index + holdBars, close - activeSlPips * 0.0001,
                           color=color.red, width=2, style=line.style_solid)
        tpLine := line.new(bar_index, close + activeTpPips * 0.0001, bar_index + holdBars, close + activeTpPips * 0.0001,
                           color=color.green, width=2, style=line.style_solid)
    if shortSignal
        slLine := line.new(bar_index, close + activeSlPips * 0.0001, bar_index + holdBars, close + activeSlPips * 0.0001,
                           color=color.red, width=2, style=line.style_solid)
        tpLine := line.new(bar_index, close - activeTpPips * 0.0001, bar_index + holdBars, close - activeTpPips * 0.0001,
                           color=color.green, width=2, style=line.style_solid)

// ═══════════════════════════════════════════════════════════════
// ИНФОРМАЦИОННАЯ ПАНЕЛЬ (DASHBOARD)
// ═══════════════════════════════════════════════════════════════

if showDashboard and barstate.islast
    var table dash = table.new(position.top_right, 2, 11,
                               bgcolor=color.new(color.black, 80),
                               border_width=1,
                               border_color=color.new(color.gray, 50))

    table.cell(dash, 0, 0, "EUR/USD Dual Strategy", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
    table.cell(dash, 1, 0, "v3.0", text_color=color.gray, text_size=size.small)

    // Asian Range info
    table.cell(dash, 0, 1, "Asian Range:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, asianDefined ? str.tostring(asianRange, "#.0") + " pips" : "Building...",
               text_color=asianDefined ? (rangeOk ? color.green : color.red) : color.yellow, text_size=size.small)

    table.cell(dash, 0, 2, "Asian High:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, not na(asianHigh) ? str.tostring(asianHigh, "#.#####") : "-", text_color=color.teal, text_size=size.small)

    table.cell(dash, 0, 3, "Asian Low:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, not na(asianLow) ? str.tostring(asianLow, "#.#####") : "-", text_color=color.red, text_size=size.small)

    // London Breakout status
    table.cell(dash, 0, 4, "--- LONDON BREAKOUT ---", text_color=color.green, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, isLondonEntry ? "ACTIVE" : "WAIT", text_color=isLondonEntry ? color.green : color.gray, text_size=size.small)

    table.cell(dash, 0, 5, "LB SL/TP:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    lbInfo = not na(lbSlPips) ? str.tostring(lbSlPips, "#.0") + " / " + str.tostring(lbTpPips, "#.0") + " pips" : "-"
    table.cell(dash, 1, 5, lbInfo, text_color=color.white, text_size=size.small)

    // Overlap Momentum status
    table.cell(dash, 0, 6, "--- OVERLAP MOMENTUM ---", text_color=color.blue, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, useOverlap ? (isOverlapEntry ? "ACTIVE" : "WAIT") : "OFF", text_color=useOverlap ? (isOverlapEntry ? color.blue : color.gray) : color.red, text_size=size.small)

    table.cell(dash, 0, 7, "OM SL/TP:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, str.tostring(omSlPips, "#.0") + " / " + str.tostring(omTpPips, "#.0") + " pips", text_color=color.white, text_size=size.small)

    // General info
    table.cell(dash, 0, 8, "EMA Trend:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    emaTxt = useEmaFilter ? (close > emaValue ? "BULLISH" : "BEARISH") : "OFF"
    emaClr = useEmaFilter ? (close > emaValue ? color.green : color.red) : color.gray
    table.cell(dash, 1, 8, emaTxt, text_color=emaClr, text_size=size.small)

    table.cell(dash, 0, 9, "RSI:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 9, str.tostring(rsiValue, "#.0"), text_color=rsiValue > 50 ? color.green : color.red, text_size=size.small)

    table.cell(dash, 0, 10, "Trades Today:", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10, str.tostring(tradesToday) + "/" + str.tostring(maxTradesPerDay) + " (LB:" + str.tostring(londonTradesToday) + " OM:" + str.tostring(overlapTradesToday) + ")",
               text_color=tradesToday >= maxTradesPerDay ? color.red : color.green, text_size=size.small)

// ═══════════════════════════════════════════════════════════════
// АЛЕРТЫ (ALERTS)
// ═══════════════════════════════════════════════════════════════

alertcondition(lbLongSignal,  title="London BUY",    message="EUR/USD London Breakout: BUY at {{close}}")
alertcondition(lbShortSignal, title="London SELL",   message="EUR/USD London Breakout: SELL at {{close}}")
alertcondition(omLongSignal,  title="Overlap BUY",   message="EUR/USD Overlap Momentum: BUY at {{close}}")
alertcondition(omShortSignal, title="Overlap SELL",  message="EUR/USD Overlap Momentum: SELL at {{close}}")
alertcondition(longSignal or shortSignal, title="Any Signal", message="EUR/USD: Trade signal at {{close}}")

// Hidden plots for alerts
plot(activeSlPips, "Active SL Pips", display=display.none)
plot(activeTpPips, "Active TP Pips", display=display.none)
plot(asianRange, "Asian Range", display=display.none)

// Background coloring for sessions
bgcolor(isAsianSession ? color.new(color.blue, 95) : na, title="Asian Session")
bgcolor(isLondonEntry ? color.new(color.green, 95) : na, title="London Entry Window")
bgcolor(useOverlap and isOverlapEntry ? color.new(color.purple, 95) : na, title="Overlap Entry Window")
